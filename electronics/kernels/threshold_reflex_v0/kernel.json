{
  "id": "threshold_reflex_v0",
  "title": "Threshold Reflex V0",
  "schema_version": "monogate-electronics.kernel.v0",
  "inputs": [
    {
      "name": "pot_raw",
      "type": "float",
      "range": [0.0, 1.0]
    }
  ],
  "outputs": [
    "requested_output",
    "safe_output",
    "led",
    "buzzer",
    "stepper"
  ],
  "parameters": {
    "threshold": 0.55,
    "width": 0.10,
    "max_step": 0.20,
    "safe_output_limit": 0.85,
    "buzzer_on_level": 0.12,
    "buzzer_off_level": 0.06
  },
  "guard": {
    "bottleneck": "output_duty_margin",
    "actions": ["pass_through", "clamp_to_safe_output"]
  }
}
